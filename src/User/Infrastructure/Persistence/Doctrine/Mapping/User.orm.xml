<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping
    xmlns="https://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        https://doctrine-project.org/schemas/orm/doctrine-mapping
        https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\User\Domain\User" table="`user`">
        <id name="id" type="uuid" column="id"/>

        <field name="email" type="string" column="email" length="254" nullable="false"/>

        <field name="password" type="string" column="password" length="254" nullable="false"/>

        <field name="role" type="string" column="role" length="50" nullable="false" enum-type="App\User\Domain\ValueObject\Role"/>

        <field name="enabled" type="boolean" column="enabled" nullable="false"/>

        <field name="deleted" type="boolean" column="deleted" nullable="false"/>

        <field name="createdAt" type="datetimetz_immutable" column="created_at" nullable="false"/>
    </entity>
</doctrine-mapping>
